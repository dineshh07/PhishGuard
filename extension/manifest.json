{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "1.0.0",
  "description": "Real-time phishing URL detection and protection.",

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://*/*",
    "https://*/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "warning.js"
      ],
      "run_at": "document_idle"
    }
  ]
}